generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum JobRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Provider {
  id                            String              @id @default(uuid()) @db.Uuid
  mobileNumber                  String              @unique @map("mobile_number")
  email                         String?             @unique
  passwordHash                  String?             @map("password_hash")
  accountStatus                 ProviderStatus      @default(PENDING) @map("account_status")
  isMobileVerified              Boolean             @default(false) @map("is_mobile_verified")
  isEmailVerified               Boolean             @default(false) @map("is_email_verified")
  isAvailable                   Boolean             @default(false) @map("is_available")
  kycStatus                     KycStatus           @default(NOT_STARTED) @map("kyc_status")
  profileCompletionPercentage   Int                 @default(0) @map("profile_completion_percentage")
  lastLoginAt                   DateTime?           @map("last_login_at")
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")

  profile           ProviderProfile?
  bankAccount       BankAccount?
  services          ProviderService[]
  skills            ProviderSkill[]
  documents         ProviderDocument[]
  kycVerifications  KycVerification[]
  locations         ProviderLocation[]
  jobRequests       JobRequest[]
  jobs              Job[]
  earnings          Earnings?
  transactions      Transaction[]
  withdrawals       Withdrawal[]
  reviews           Review[]
  notifications     Notification[]
  sessions          Session[]

  @@map("providers")
}

model ProviderProfile {
  id                      String    @id @default(uuid()) @db.Uuid
  providerId              String    @unique @db.Uuid @map("provider_id")
  fullName                String?   @map("full_name")
  dob                     DateTime? @db.Date
  gender                  String?
  profilePhotoUrl         String?   @map("profile_photo_url")
  totalExperienceYears    Int       @default(0) @map("total_experience_years")
  experienceDescription   String?   @map("experience_description") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  iconUrl     String?  @map("icon_url")
  basePrice   Decimal? @db.Decimal(10, 2) @map("base_price")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  providerServices ProviderService[]
  jobRequests      JobRequest[]
  jobs             Job[]

  @@map("services")
}

model ProviderService {
  providerId String @db.Uuid @map("provider_id")
  serviceId  String @db.Uuid @map("service_id")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@map("provider_services")
}

model ProviderSkill {
  providerId String @db.Uuid @map("provider_id")
  skillName  String @map("skill_name")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([providerId, skillName])
  @@map("provider_skills")
}

model ProviderDocument {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @db.Uuid @map("provider_id")
  documentType String   @map("document_type") // e.g. AADHAAR_FRONT, AADHAAR_BACK
  documentUrl  String   @map("document_url")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_documents")
}

model KycVerification {
  id                  String    @id @default(uuid()) @db.Uuid
  providerId          String    @db.Uuid @map("provider_id")
  providerReferenceId String?   @map("provider_reference_id")
  maskedAadhaar       String?   @map("masked_aadhaar")
  status              KycStatus @default(PENDING)
  rejectionReason     String?   @map("rejection_reason") @db.Text
  verifiedAt          DateTime? @map("verified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("kyc_verifications")
}

model BankAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  providerId            String   @unique @db.Uuid @map("provider_id")
  bankName              String   @map("bank_name")
  accountNumberEncrypted String  @map("account_number_encrypted")
  maskedAccountNumber   String   @map("masked_account_number")
  ifscCode              String   @map("ifsc_code")
  isVerified            Boolean  @default(false) @map("is_verified")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@map("bank_accounts")
}

model ProviderLocation {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid @map("provider_id")
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  accuracy   Decimal? @db.Decimal(10, 2)
  timestamp  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, timestamp(sort: Desc)])
  @@map("provider_locations")
}

model JobRequest {
  id              String           @id @default(uuid()) @db.Uuid
  serviceId       String?          @db.Uuid @map("service_id")
  customerId      String           @db.Uuid @map("customer_id")
  providerId      String?          @db.Uuid @map("provider_id")
  pickupAddress   String           @map("pickup_address") @db.Text
  latitude        Decimal?         @db.Decimal(10, 8)
  longitude       Decimal?         @db.Decimal(11, 8)
  distanceKm      Decimal?         @db.Decimal(5, 2) @map("distance_km")
  scheduledAt     DateTime         @map("scheduled_at")
  estimatedAmount Decimal?         @db.Decimal(10, 2) @map("estimated_amount")
  expiresAt       DateTime         @map("expires_at")
  status          JobRequestStatus @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")

  service  Service?  @relation(fields: [serviceId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])
  job      Job?

  @@map("job_requests")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  jobRequestId   String?   @unique @db.Uuid @map("job_request_id")
  serviceId      String?   @db.Uuid @map("service_id")
  customerId     String    @db.Uuid @map("customer_id")
  providerId     String?   @db.Uuid @map("provider_id")
  address        String    @db.Text
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  scheduledAt    DateTime  @map("scheduled_at")
  status         JobStatus @default(ACCEPTED)
  finalAmount    Decimal?  @db.Decimal(10, 2) @map("final_amount")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  jobRequest JobRequest? @relation(fields: [jobRequestId], references: [id])
  service    Service?    @relation(fields: [serviceId], references: [id])
  provider   Provider?   @relation(fields: [providerId], references: [id])

  checklists    JobChecklist[]
  statusHistory JobStatusHistory[]
  transactions  Transaction[]
  review        Review?

  @@map("jobs")
}

model JobChecklist {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @db.Uuid @map("job_id")
  itemName    String   @map("item_name")
  isCompleted Boolean  @default(false) @map("is_completed")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_checklists")
}

model JobStatusHistory {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid @map("job_id")
  status    JobStatus
  latitude  Decimal?  @db.Decimal(10, 8)
  longitude Decimal?  @db.Decimal(11, 8)
  createdAt DateTime  @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_status_history")
}

model Earnings {
  providerId     String   @id @db.Uuid @map("provider_id")
  totalBalance   Decimal  @default(0) @db.Decimal(10, 2) @map("total_balance")
  totalEarned    Decimal  @default(0) @db.Decimal(10, 2) @map("total_earned")
  totalWithdrawn Decimal  @default(0) @db.Decimal(10, 2) @map("total_withdrawn")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("earnings")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  providerId  String?         @db.Uuid @map("provider_id")
  jobId       String?         @db.Uuid @map("job_id")
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  provider Provider? @relation(fields: [providerId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])

  @@map("transactions")
}

model Withdrawal {
  id                String           @id @default(uuid()) @db.Uuid
  providerId        String?          @db.Uuid @map("provider_id")
  bankAccountId     String?          @db.Uuid @map("bank_account_id")
  amount            Decimal          @db.Decimal(10, 2)
  status            WithdrawalStatus @default(PENDING)
  payoutReferenceId String?          @map("payout_reference_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  provider    Provider?    @relation(fields: [providerId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("withdrawals")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  jobId      String   @unique @db.Uuid @map("job_id")
  providerId String?  @db.Uuid @map("provider_id")
  customerId String   @db.Uuid @map("customer_id")
  rating     Int      @db.SmallInt
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  job      Job       @relation(fields: [jobId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@map("reviews")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @db.Uuid @map("provider_id")
  type        String
  title       String
  description String?  @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @db.Uuid @map("provider_id")
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  deviceInfo   String?  @map("device_info")
  createdAt    DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OtpVerification {
  id           String   @id @default(uuid()) @db.Uuid
  mobileNumber String   @map("mobile_number")
  otpHash      String   @map("otp_hash")
  expiresAt    DateTime @map("expires_at")
  attempts     Int      @default(0)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}
