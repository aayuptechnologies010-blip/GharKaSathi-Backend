PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/ghar-ka-saathi

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Firebase Admin SDK service account (used to verify phone-auth ID tokens from the mobile app)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seed script (npm run seed:admin) creates the first admin using these
ADMIN_SEED_EMAIL=admin@gharkasaathi.com
ADMIN_SEED_PASSWORD=change-me

# Razorpay (used for online payment on bookings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
