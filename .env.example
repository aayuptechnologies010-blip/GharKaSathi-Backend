PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/ghar-ka-saathi

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Phone OTP login has no SMS gateway wired up yet — in non-production NODE_ENV, /api/auth/send-otp
# returns the generated code in the response (and logs it) so the flow is testable end-to-end.

# Seed script (npm run seed:admin) creates the first admin using these
ADMIN_SEED_EMAIL=admin@gharkasaathi.com
ADMIN_SEED_PASSWORD=change-me

# Razorpay (used for online payment on bookings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
