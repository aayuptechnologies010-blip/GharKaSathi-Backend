# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gharkasathi?schema=public"

# Authentication / JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Integrations - OTP Provider (e.g. Twilio, MSG91)
OTP_PROVIDER=mock
OTP_API_KEY=your_otp_api_key_here

# Integrations - KYC Provider
KYC_PROVIDER=mock
KYC_API_KEY=your_kyc_api_key_here

# Integrations - Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Integrations - Notifications (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Integrations - Storage (AWS S3, GCP, Cloudinary, etc.)
STORAGE_PROVIDER=mock
STORAGE_BUCKET=gharkasathi-bucket
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# Integrations - Payouts / Payments (Razorpay, Stripe)
PAYOUT_PROVIDER=mock
PAYOUT_API_KEY=your_payout_api_key
PAYOUT_API_SECRET=your_payout_api_secret
